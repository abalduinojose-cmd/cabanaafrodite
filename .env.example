# ---------------------------------------------------------------------------
# Calendario do Airbnb (SECRETO: veja o README)
# ---------------------------------------------------------------------------
AIRBNB_ICAL_URL="https://www.airbnb.com.br/calendar/ical/SEU_ID.ics?t=SEU_TOKEN"

# ---------------------------------------------------------------------------
# Motor de reservas. Sem estas, o site funciona como vitrine e manda para o
# Airbnb. Com elas, o formulario de reserva aparece.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_RESERVAS_ATIVAS=1
NEXT_PUBLIC_SITE_URL="https://www.cabanaafrodite.com.br"

# Postgres (Neon, Supabase, Vercel Postgres...)
DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"

# Mercado Pago > Suas integracoes > sua aplicacao
MP_ACCESS_TOKEN="APP_USR-..."
MP_WEBHOOK_SECRET="..."

# ---------------------------------------------------------------------------
# Regras comerciais (valores em reais)
# ---------------------------------------------------------------------------
PRECO_NOITE=650
TAXA_LIMPEZA=150
MINIMO_NOITES=1
SINAL_PERCENTUAL=100
MINUTOS_PARA_PAGAR=30
JANELA_DIAS=365
